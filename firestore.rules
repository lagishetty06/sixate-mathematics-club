rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Applications — public read (Admin Dashboard reads without login),
    // restricted create (student form only), open update for status changes,
    // no delete allowed.
    match /applications/{docId} {
      allow read: if true;

      allow create: if request.resource.data.rollNumber == docId
                    && request.resource.data.status == "pending"
                    && (!("memberId" in request.resource.data) || request.resource.data.memberId == null)
                    && request.resource.data.fullName is string
                    && request.resource.data.email is string;

      allow update: if true;
      allow delete: if false;
    }

    // Email Index — public read and create (duplicate-check), no modifications.
    match /emailIndex/{email} {
      allow create: if !exists(/databases/$(database)/documents/emailIndex/$(email));
      allow read: if true;
      allow update, delete: if false;
    }

    // Counters — public get for sequential ID generation, no list/delete.
    match /counters/{counterName} {
      allow get: if true;
      allow list: if false;

      allow update: if
        ("count" in request.resource.data &&
         "count" in resource.data &&
         request.resource.data.count == resource.data.count + 1)
        ||
        ("value" in request.resource.data &&
         "value" in resource.data &&
         request.resource.data.value == resource.data.value + 1);

      allow create, delete: if false;
    }

    // Admins collection — fully locked (no login system used).
    match /admins/{uid} {
      allow read, write: if false;
    }
  }
}
